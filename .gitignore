__pycache__/
*.py[cod]
.ipynb_checkpoints/
.vscode/

# Bí mật: không bao giờ commit
.env
.env.colab

# Dữ liệu: bỏ qua theo ĐUÔI tệp, để metadata và report vẫn vào git
data/raw/**/*.csv
data/raw/**/*.jsonl
data/raw/**/*.parquet
data/raw/**/*.xlsx
data/raw/**/*.zip
data/processed/**/*.csv

# Model tải về: bỏ qua nội dung, nhưng giữ tệp giải thích
data/models/*
!data/models/.gitkeep
!data/models/README.md

# Kết quả thí nghiệm: chỉ commit phần nhẹ
experiments/**/results/**/predictions.csv
experiments/**/results/**/predictions/
experiments/**/results/**/plots/
experiments/**/results/**/model/
