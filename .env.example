# Mẫu cho máy cá nhân. Sao chép thành .env rồi điền giá trị thật.
# .env KHÔNG được commit.

DAGSHUB_TOKEN=
SENTIMENTX_ENV=local
# Đường dẫn bản trọng số có sẵn trên máy (bỏ trống thì dùng `checkpoint` trong configs/models/<model_id>.yaml).
SENTIMENTX_MODEL=
HF_HOME=

# Chỉ điền khi muốn trỏ dữ liệu hoặc kết quả sang nơi khác
SENTIMENTX_DATA_ROOT=
SENTIMENTX_RESULTS_ROOT=

# Ngắt phiên Colab khi chạy xong, khi lượt chạy lỗi, hoặc khi ô kiểm trước dừng
# (SENTIMENTX_END_SESSION).
# 1 = bật (mặc định trên Colab), 0 = giữ phiên lại. Trên máy cá nhân không có gì để ngắt.
SENTIMENTX_END_SESSION=1
