# Mẫu cho máy cá nhân. Sao chép thành .env rồi điền giá trị thật.
# .env KHÔNG được commit.

DAGSHUB_TOKEN=
SENTIMENTX_ENV=local
# Đường dẫn bản trọng số có sẵn trên máy (bỏ trống thì dùng `checkpoint` trong configs/models/<model_id>.yaml).
SENTIMENTX_MODEL=
HF_HOME=
# Token Hugging Face. CHỈ cần khi tải repo GATED (meta-llama/Llama-3.1-8B-Instruct,
# Viet-Mistral/Vistral-7B-Chat): tạo ở https://huggingface.co/settings/tokens (quyền Read)
# rồi bấm nhận điều khoản trên trang model. Bỏ trống thì mọi lượt KHÁC vẫn chạy bình thường.
HF_TOKEN=

# Chỉ điền khi muốn trỏ dữ liệu hoặc kết quả sang nơi khác
SENTIMENTX_DATA_ROOT=
SENTIMENTX_RESULTS_ROOT=

# Ngắt phiên Colab khi chạy xong, khi lượt chạy lỗi, hoặc khi ô kiểm trước dừng
# (SENTIMENTX_END_SESSION).
# 1 = bật (mặc định trên Colab), 0 = giữ phiên lại. Trên máy cá nhân không có gì để ngắt.
SENTIMENTX_END_SESSION=1

# ---------------------------------------------------------------------------
# Serving layer (FastAPI web service)
# ---------------------------------------------------------------------------

# Host / cổng cho `python -m serving.app`. Mặc định trùng với configs/serving.yaml.
SERVING_HOST=127.0.0.1
SERVING_PORT=8000

# Giới hạn model được bật khi khởi động serving (danh sách id cách nhau bằng dấu phẩy).
# Bỏ trống thì dùng `enabled` trong configs/serving.yaml.
SERVING_MODELS=

# Model mặc định cho POST /predict khi client không chỉ định `model`.
SERVING_DEFAULT_MODEL=

# Nếu đặt, toàn bộ endpoint (trừ /, /health, /static) yêu cầu X-API-Key hoặc
# Authorization: Bearer. Bỏ trống = không bật API key.
SERVING_API_KEY=

# Cho phép ghi log nội dung văn bản đầu vào (chỉ bật khi debug). Mặc định 0.
SERVING_LOG_TEXT=0

# Offline mode cho Hugging Face: không gọi mạng khi tải model.
HF_HUB_OFFLINE=1

# Cấu hình cấp phát bộ nhớ CUDA (giảm phân mảnh VRAM cho serving 2 model tuần tự).
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
