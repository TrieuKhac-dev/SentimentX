# Mẫu cho Colab. Nhóm sao chép thành .env.colab, điền ĐẦY ĐỦ rồi gửi cho giảng viên.
# .env.colab KHÔNG được commit. Nên đặt tại <Drive>/env/.env.colab để notebook tự tìm.

DAGSHUB_TOKEN=
SENTIMENTX_ENV=colab
SENTIMENTX_DATA_ROOT=/content/drive/MyDrive/<tên folder giảng viên cấp>/data
SENTIMENTX_RESULTS_ROOT=/content/drive/MyDrive/<tên folder giảng viên cấp>/experiments
# Đường dẫn bản trọng số có sẵn trên máy (bỏ trống thì dùng `checkpoint` trong configs/models/<model_id>.yaml).
SENTIMENTX_MODEL=
HF_HOME=/content/hf_cache
# Token Hugging Face. CHỈ cần khi tải repo GATED (meta-llama/Llama-3.1-8B-Instruct,
# Viet-Mistral/Vistral-7B-Chat). Trên Colab có thể để TRỐNG ở đây và đặt ở Secrets > HF_TOKEN
# (notebook đọc Secrets TRƯỚC file này); máy cá nhân thì điền vào `.env`.
HF_TOKEN=

# Ngắt phiên Colab khi chạy xong, khi lượt chạy lỗi, hoặc khi ô kiểm trước dừng
# (SENTIMENTX_END_SESSION).
# 1 = bật (mặc định trên Colab), 0 = giữ phiên lại. Trên máy cá nhân không có gì để ngắt.
SENTIMENTX_END_SESSION=1
