# Mẫu cho Colab. Nhóm sao chép thành .env.colab, điền ĐẦY ĐỦ rồi gửi cho giảng viên.
# .env.colab KHÔNG được commit. Nên đặt tại <Drive>/env/.env.colab để notebook tự tìm.

DAGSHUB_TOKEN=
SENTIMENTX_ENV=colab
SENTIMENTX_DATA_ROOT=/content/drive/MyDrive/<tên folder giảng viên cấp>/data
SENTIMENTX_RESULTS_ROOT=/content/drive/MyDrive/<tên folder giảng viên cấp>/experiments
HF_HOME=/content/hf_cache
