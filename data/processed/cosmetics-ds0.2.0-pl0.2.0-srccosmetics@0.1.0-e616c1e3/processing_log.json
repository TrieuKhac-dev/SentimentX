  "pipeline": {
    "version": "v0.2.0",
    "config": "configs/pipeline/v0.2.0.yaml",
    "config_sha256": "b7f6e8fc55cdaa234f71b0c0b5b1530a7d021756347516ca4f209984fa2d1da9",
    "settings": {
      "version": "v0.2.0",
      "parent": "v0.1.0",
      "notes": "Khác v0.1.0 đúng MỘT điều: `test` KHÔNG bị sửa. `apply_to` của Clean và Normalize chỉ có [train, val], nên test.csv bằng đúng dữ liệu gốc (1.623 dòng) - điều kiện để so được với công bố tham chiếu, vì công bố cũng chấm trên tập test nguyên bản. Rò rỉ dữ liệu vì thế được xử lý ở phía TẬP HỌC: luật `keep_priority: [test, val, train]` giữ bản ghi ở tập ưu tiên cao hơn và loại khỏi các tập thấp hơn, nên test không bao giờ bị loại, và điểm của lượt học (LoRA) không bị \"phồng\" vì model đã thấy trước câu hỏi. Train và val của bản này vì vậy khác v0.1.0 một chút.\n",
      "steps": {
        "validate": {
          "check_schema": true,
          "check_content": true
        },
        "clean": {
          "apply_to": [
            "train",
            "val"
          ],
          "remove_empty": true,
          "remove_gibberish": true,
          "remove_ads": true,
          "remove_code": true,
          "deduplicate": {
            "exact": true,
            "normalized": true,
            "ignore_diacritics": false,
            "scope": "within_split",
            "conflict_policy": "quarantine"
          },
          "leakage": {
            "keep_priority": [
              "test",
              "val",
              "train"
            ]
          }
        },
        "normalize": {
          "apply_to": [
            "train",
            "val"
          ],
          "lowercase": false,
          "unicode": true,
          "whitespace": true,
          "repeated_chars": false
        },
        "transform": {
          "format": "multi_head"
        }
      },
      "thresholds": {
        "repeated_chars_max": 2
      }
    }
  },
