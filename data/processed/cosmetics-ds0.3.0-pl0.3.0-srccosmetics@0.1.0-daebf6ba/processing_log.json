  "pipeline": {
    "version": "v0.3.0",
    "config": "configs/pipeline/v0.3.0.yaml",
    "config_sha256": "de49843280a91cc777dc85d40ed4f2960f2c053ed2792fcf55da05c9b7304d18",
    "settings": {
      "version": "v0.3.0",
      "parent": "v0.2.0",
      "notes": "Khác v0.2.0 đúng MỘT điều: bước Normalize có thêm khoá `remove_emoji: true`, bỏ emoji khỏi văn bản của `train` và `val` trước khi đưa vào model. Mục đích là trả lời câu hỏi phản biện \"tiền xử lý emoji có ảnh hưởng tới kết quả không\" bằng một PHÉP ĐO thật thay vì suy đoán: số review có emoji chỉ chiếm khoảng 14% mỗi split (1.931/12.981 ở train, 233/1.623 ở val), nên đây là phép can thiệp nhỏ, và mọi chênh lệch quan sát được đều phải đọc kèm biên nhiễu +-0,7 điểm. `test` VẪN KHÔNG BỊ SỬA (như v0.2.0): văn bản của test giữ nguyên từng ký tự, kể cả emoji - đó là điều kiện để còn so được với công bố tham chiếu. Review CHỈ gồm emoji (không còn chữ nào) thì được GIỮ NGUYÊN: bỏ hết sẽ tạo dòng rỗng, mà bước Clean - bước duy nhất loại review rỗng - đã chạy trước bước Normalize. Đây là lựa chọn có chủ ý, không phải sót.\n",
      "steps": {
        "validate": {
          "check_schema": true,
          "check_content": true
        },
        "clean": {
          "apply_to": [
            "train",
            "val"
          ],
          "remove_empty": true,
          "remove_gibberish": true,
          "remove_ads": true,
          "remove_code": true,
          "deduplicate": {
            "exact": true,
            "normalized": true,
            "ignore_diacritics": false,
            "scope": "within_split",
            "conflict_policy": "quarantine"
          },
          "leakage": {
            "keep_priority": [
              "test",
              "val",
              "train"
            ]
          }
        },
        "normalize": {
          "apply_to": [
            "train",
            "val"
          ],
          "lowercase": false,
          "unicode": true,
          "whitespace": true,
          "remove_emoji": true,
          "repeated_chars": false
        },
        "transform": {
          "format": "multi_head"
        }
      },
      "thresholds": {
        "repeated_chars_max": 2
      }
    }
  },
